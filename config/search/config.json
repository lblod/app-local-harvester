{
    "automatic_index_updates": true,
    "persist_indexes": true,
    "update_wait_interval_minutes": 0.1,
    "number_of_threads": 4,
    "eager_indexing_groups": [
        [
            {
                "name": "public",
                "variables": []
            }
        ],
        [
            {
                "name": "clean",
                "variables": []
            }
        ]
    ],
    "types": [
        {
            "type": "geometry",
            "on_path": "geometries",
            "rdf_type": "http://www.w3.org/ns/locn#Geometry",
            "properties": {
                "coord": {
                    "via": "http://www.opengis.net/ont/geosparql#asWKT",
                    "type": "lambert-72"
                }
            },
            "mappings": {
                "properties": {
                    "coord": {
                        "type": "geo_point"
                    }
                }
            }
        }
    ]
}
